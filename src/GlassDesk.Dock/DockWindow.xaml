<controls:GlassWindow
    x:Class="GlassDesk.Dock.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI"
    Title="GlassDesk Dock"
    AutomationProperties.Name="GlassDesk 程序坞"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="Manual"
    Topmost="True"
    AllowDrop="True"
    Drop="OnExternalDrop"
    DragOver="OnExternalDragOver">

  <controls:GlassWindow.Resources>
    <Style x:Key="DockEntryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </controls:GlassWindow.Resources>

  <Border
      Background="Transparent"
      BorderThickness="0"
      SnapsToDevicePixels="True">

    <Grid ClipToBounds="True">
      <controls:LiquidGlassSurface x:Name="GlassSurface" />
      <Grid x:Name="DockVisualRoot" ClipToBounds="True" RenderTransformOrigin="0,0">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="DockSlideTransform" />
        </Grid.RenderTransform>
        <StackPanel x:Name="DockContentLayer" Orientation="Vertical" Margin="10,8">

          <!-- 小组件内联面板：点击小组件图标时在 Dock 栏上部弹出 -->
          <ScrollViewer x:Name="DockWidgetPanel"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        VerticalScrollBarVisibility="Auto"
                        MaxHeight="340"
                        Focusable="False">
            <ContentPresenter />
          </ScrollViewer>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="LauncherButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                    Style="{StaticResource DockEntryButton}"
                    Background="Transparent" BorderThickness="0"
                    ToolTip="启动台" AutomationProperties.Name="打开启动台"
                    MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                    Click="OnLauncherButtonClick">
              <controls:PhoneBorder x:Name="LaunchpadTile" Width="48" Height="48" CornerRadius="16"
                         Background="Transparent" BorderThickness="0">
                <controls:LaunchpadGlyph OutlineBrush="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
              </controls:PhoneBorder>
            </Button>
            <Button x:Name="ThisPcButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                    Style="{StaticResource DockEntryButton}"
                    Background="Transparent" BorderThickness="0"
                    ToolTip="此电脑" AutomationProperties.Name="打开此电脑"
                    MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                    Click="OnThisPcButtonClick">
              <Viewbox x:Name="ThisPcTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="48" Height="48">
                  <Path Data="M6,6 H42 Q45,6 45,9 V29 Q45,32 42,32 H6 Q3,32 3,29 V9 Q3,6 6,6 Z M24,32 V39 M15,40 H33"
                        Fill="Transparent"
                        Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                        StrokeThickness="3.5" StrokeLineJoin="Round"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="DesktopIconsButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                    Style="{StaticResource DockEntryButton}"
                    ToolTip="切换桌面图标显示" AutomationProperties.Name="切换桌面图标显示"
                    MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                    Click="OnDesktopIconsButtonClick">
              <Viewbox x:Name="DesktopIconsTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="48" Height="48">
                  <Path Data="M6,6 H42 Q45,6 45,9 V29 Q45,32 42,32 H6 Q3,32 3,29 V9 Q3,6 6,6 Z M24,32 V39 M15,40 H33"
                        Fill="Transparent"
                        Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                        StrokeThickness="3.5" StrokeLineJoin="Round"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <Path Data="M11,12 H15 V16 H11 Z M11,22 H15 V26 H11 Z M23,15 H37 M32,10 L37,15 L32,20 M37,24 H23 M28,19 L23,24 L28,29"
                        Fill="Transparent"
                        Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                        StrokeThickness="3.5" StrokeLineJoin="Round"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button x:Name="SettingsButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0"
                    Style="{StaticResource DockEntryButton}"
                    ToolTip="GlassDesk 设置" AutomationProperties.Name="打开 GlassDesk 设置"
                    MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave"
                    Click="OnSettingsButtonClick">
              <Viewbox x:Name="SettingsTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="48" Height="48">
                  <Path Data="M24,15 A9,9 0 1,1 23.99,15 M24,21 A3,3 0 1,0 24,27 M24,21 A3,3 0 1,1 24,27"
                        Fill="Transparent"
                        Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                        StrokeThickness="3.2" StrokeLineJoin="Round" />
                  <Path Data="M12,30 L13.2,26.5 M36,30 L34.8,26.5 M12,18 L13.2,21.5 M36,18 L34.8,21.5 M18,12 L21.5,13.2 M30,12 L26.5,13.2 M18,36 L21.5,34.8 M30,36 L26.5,34.8"
                        Fill="Transparent"
                        Stroke="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                        StrokeThickness="3.2" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
            </Button>
            <ContentControl x:Name="TileStripHost"
                            AutomationProperties.Name="固定的应用"
                            Focusable="False" />
            <ContentControl x:Name="WidgetStripHost"
                            AutomationProperties.Name="小组件"
                            Focusable="False" />
          </StackPanel>

          <TextBlock
              x:Name="StatusText"
              Margin="2,8,2,0"
              HorizontalAlignment="Center"
              FontSize="11"
              Visibility="Collapsed"
              Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />

        </StackPanel>
      </Grid>
    </Grid>
  </Border>

</controls:GlassWindow>
